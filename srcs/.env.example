# Copié automatiquement en srcs/.env par `make` s'il n'existe pas. Changez les secrets !
# Port du site en production (make prod)
HTTP_PORT=8080

# Ports exposés en développement (make dev)
DEV_FRONTEND_PORT=4200
DEV_DB_PORT=5433

POSTGRES_DB=presidentielle
POSTGRES_USER=presidentielle
POSTGRES_PASSWORD=change-me-db-password

DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Compte administrateur créé au premier démarrage
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# Agenda : calendrier public Zetkin de la campagne (facultatif, valeur par défaut ci-dessous)
# ZETKIN_ICS_URL=https://app.zetkin.org/o/1030/events.ics
